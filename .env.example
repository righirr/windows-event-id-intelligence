# Copy this file to .env and adjust, or set these as shell env vars before
# running `docker compose up`. These should match the Interface IP / Port
# you enter in the app's own ⚙ Settings panel.

# The LAN interface to bind on this host. Use 0.0.0.0 to listen on every
# interface (default) instead of one specific IP.
HOST_IP=192.168.3.100

# The port to expose the app on.
HOST_PORT=8080
